# ============================================
# STAGING ENVIRONMENT
# ============================================
# Use this to test production setup before deploying

# Database (PostgreSQL - test instance)
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://prakruthi:CHANGE_THIS_PASSWORD@prakruthi-db-staging.XXXXX.rds.amazonaws.com:5432/prakruthi_db_staging"

# Server Configuration
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# CORS - Staging domain
CORS_ORIGIN="https://staging.yourdomain.com,https://staging-admin.yourdomain.com"

# Authentication
JWT_SECRET="STAGING_SECRET_CHANGE_BEFORE_PRODUCTION"

# OTP Configuration
OTP_PROVIDER=mock

# Frontend API URLs
VITE_API_BASE_URL="https://staging-api.yourdomain.com/api"
