# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ============================================

# Database (SQLite for local dev - zero setup needed)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./services/api/prisma/dev.db"

# Server Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# CORS - Allow all local dev origins
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000,http://localhost:3001"

# Authentication
JWT_SECRET="dev-secret-key-123-change-in-production"

# OTP Configuration (Mock for local testing)
OTP_PROVIDER=mock
OTP_API_KEY=""

# Frontend API URLs
VITE_API_BASE_URL="http://localhost:4000/api"
