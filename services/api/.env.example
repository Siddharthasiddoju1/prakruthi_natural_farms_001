# ============================================
# Production Environment Variables Template
# Copy to .env and fill in real values
# NEVER commit .env to git
# ============================================

# Database (RDS PostgreSQL)
DATABASE_URL=postgresql://prakruthi_admin:YOUR_PASSWORD@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/prakruthi_db

# Authentication
JWT_SECRET=generate-a-strong-64-char-random-string-here
JWT_EXPIRES_IN=7d

# OTP Provider (twilio / msg91 / firebase)
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://prakruthi.com,https://admin.prakruthi.com

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_ACCOUNT_ID=123456789012

# S3 (Product Images)
S3_BUCKET_NAME=prakruthi-product-images
S3_REGION=ap-south-1

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn

# SonarQube
SONAR_TOKEN=your_sonarqube_token
SONAR_HOST_URL=https://sonarqube.your-domain.com
