{
  "name": "prakruthi-natural-farms-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:api": "npm --workspace services/api run dev",
    "build": "npm run build:web; npm run build:admin; npm run build:api",
    "build:web": "npm --workspace apps/web run build",
    "build:admin": "npm --workspace apps/admin run build",
    "build:api": "npm --workspace services/api run build"
  }
}
